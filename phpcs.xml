<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards - SnippetCrate">
	<description>Custom PHPCS ruleset for SnippetCrate development (PHP 7.4+).</description>

	<!-- Base WordPress Coding Standards -->
	<rule ref="WordPress-Core" />
	<rule ref="WordPress-Extra" />
	<rule ref="WordPress-Docs" />

	<!-- PHP Compatibility -->
	<rule ref="PHPCompatibilityWP" />
	<config name="testVersion" value="7.4-" />
	<config name="minimum_supported_wp_version" value="5.2" />

	<!-- I18n text domain check -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="snippetcrate"/>
			</property>
		</properties>
	</rule>

	<!-- File name rules exclusions -->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>includes/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>includes/*</exclude-pattern>
	</rule>

	<!-- Ignore vendor and build folders -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<!-- Only scan PHP files -->
	<fileExtensions>
		<extension>php</extension>
	</fileExtensions>
</ruleset>
