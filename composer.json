{
    "name": "wpmilan/snippetcrate",
    "description": "Add, manage and run custom PHP, JavaScript, CSS and HTML code snippets in WordPress.",
    "version": "1.0.0",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "SnippetCrate\\": "includes/"
        }
    },
    "authors": [
        {
            "name": "milan",
            "email": "chaudharymilan996@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "^2.0"
    },
    "require-dev": {
        "wp-cli/wp-cli": "^2.8",
        "wp-cli/i18n-command": "^2.2",
        "squizlabs/php_codesniffer": "^3.7",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "scripts": {
        "phpcs": [
            "phpcs -s -p"
        ],
        "phpcs-pre-commit": [
            "phpcs -s -p -n"
        ],
        "phpcbf": [
            "phpcbf -p"
        ],
        "makepot-audit": [
            "\"vendor/bin/wp\" i18n make-pot . --exclude=\".github,.wordpress-org,bin,node_modules,vendor,tests,build,release\" --slug=snippetcrate"
        ],
        "makepot": [
            "@makepot-audit --skip-audit"
        ]
    },
    "extra": {
        "scripts-description": {
            "phpcs": "Analyze code against the WordPress coding standards with PHP_CodeSniffer",
            "phpcbf": "Fix coding standards warnings/errors automatically with PHP Code Beautifier",
            "makepot-audit": "Generate languages/snippetcrate.pot file and run audit",
            "makepot": "Generate languages/snippetcrate.pot file"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4"
        }
    }
}
