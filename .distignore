# Files and directories that must NOT ship in the WordPress.org distribution.
.*
bin
node_modules
src
tests
build
release
webpack
.wordpress-org

# Build / tooling config (not needed at runtime)
composer.json
composer.lock
package.json
package-lock.json
pnpm-lock.yaml
webpack.config.js
postcss.config.js
tailwind.config.js
tsconfig.json
gulpFile.js
phpcs.xml
phpcs.xml.dist
.babelrc
.eslintrc.js

# Docs / dev-only
README.md
CLAUDE.md
output.log
docker_tag
DOCKER_ENV

# Build artifacts that should never ship
dist/report.html
